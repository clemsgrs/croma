    given-names: Clément
    email: clement.grisi@radboudumc.nl
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
  - family-names: van der Laak
    given-names: Jeroen
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
  - family-names: Litjens
    given-names: Geert
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
version: 0.1.0
license: Apache-2.0
repository-code: "https://github.com/clemsgrs/croma"
url: "https://clemsgrs.github.io/croma/"
keywords:
  - pathology
  - foundation-models
  - robustness
  - representation-learning
  - metrics
