cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: croma
abstract: >-
  Robustness metrics for pathology foundation models. Implements the Robustness Index
  (RI), the Margin-aware Robustness Index (MaRI), the Cross-confounder Robustness Margin
  (CRoMa), and lower-tail statistics that expose brittle subgroups which pooled scores
  hide.
type: software
authors:
  - family-names: Grisi
    given-names: Clément
    email: clement.grisi@radboudumc.nl
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
  - family-names: van der Laak
    given-names: Jeroen
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
  - family-names: Litjens
    given-names: Geert
    affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
version: 0.3.0
license: Apache-2.0
repository-code: "https://github.com/clemsgrs/croma"
url: "https://clemsgrs.github.io/croma/"
keywords:
  - pathology
  - foundation-models
  - robustness
  - representation-learning
  - metrics
# `preferred-citation:` makes GitHub's "Cite this repository" button and reference managers
# emit the paper rather than the software, while the entry above is kept as the software
# record. CFF 1.2.0 has no `preprint` reference type, so a preprint is conventionally
# `article` with `journal: arXiv`. A Zenodo DOI for the release itself would go in a
# top-level `identifiers:` block.
preferred-citation:
  type: article
  title: "A distributional robustness margin for pathology foundation models"
  authors:
    - family-names: Grisi
      given-names: Clément
      email: clement.grisi@radboudumc.nl
      affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
    - family-names: van der Laak
      given-names: Jeroen
      affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
    - family-names: Litjens
      given-names: Geert
      affiliation: "Department of Pathology, Radboud University Medical Center, Nijmegen, The Netherlands"
  year: 2026
  month: 7
  journal: arXiv
  doi: 10.48550/arXiv.2607.25497
  url: "https://arxiv.org/abs/2607.25497"
  identifiers:
